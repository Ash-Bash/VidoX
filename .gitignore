# VidoX — root .gitignore (Apple + Android monorepo)

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Editors / IDEs (shared)
*.swp
*~
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.cursor/
*.code-workspace

# Secrets & local env
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
secrets/
credentials.json
google-services.json
GoogleService-Info.plist

# ---------------- Android (VidoX_Google) ----------------
**/.gradle/
**/local.properties
**/.idea/
!**/.idea/codeStyles/
!**/.idea/runConfigurations/
**/*.iml
**/captures/
**/.externalNativeBuild/
**/.cxx/
**/build/
# APK / AAB / mapping outputs if generated outside build/
*.apk
*.aab
*.ap_
*.dex
# Native / NDK noise
obj/
libs/**/*.so
# Kotlin / AGP caches (also relocated under ~/Library/Caches/VidoX_Google)
**/.kotlin/

# ---------------- Apple / Xcode (VidoX_Apple) ----------------
**/xcuserdata/
**/*.xcuserstate
**/DerivedData/
**/build/
**/*.moved-aside
**/*.pbxuser
!default.pbxuser
**/*.mode1v3
!default.mode1v3
**/*.mode2v3
!default.mode2v3
**/*.perspectivev3
!default.perspectivev3
**/*.hmap
**/*.ipa
**/*.dSYM.zip
**/*.dSYM
**/timeline.xctimeline
**/playground.xcworkspace
**/.swiftpm/configuration/registries.json
**/.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
**/Packages/repositories/
# CocoaPods / Carthage / SPM (if added later)
Pods/
Carthage/Build/
Carthage/Checkouts/
**/SourcePackages/
**/playground*.xcworkspace

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/**/*.png
**/fastlane/test_output

# ---------------- Tests / coverage ----------------
**/coverage/
**/*.xcresult
**/jacoco/
**/test-results/
